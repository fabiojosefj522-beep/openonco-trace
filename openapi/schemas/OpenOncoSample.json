{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openonco-trace.example/v1/sample.schema.json",
  "title": "OpenOncoSample",
  "description": "Amostra biológica rastreável para terapias personalizadas contra o câncer (CAR-T autólogo e vacinas de mRNA com neoantígenos).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sampleId",
    "patientId",
    "therapyOrder",
    "biopsyType",
    "sensorTemp",
    "chainOfCustody"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Versão do contrato de dados (SemVer)."
    },
    "sampleId": {
      "type": "string",
      "pattern": "^SMP-[0-9]{4}-[A-Z0-9]{6}$",
      "description": "ID único da amostra; em produção, mapeado da etiqueta ISBT 128 ou GS1."
    },
    "patientId": {
      "type": "string",
      "pattern": "^PT-[A-Z]{2}-[0-9]{6}$",
      "description": "Pseudônimo do paciente lido na etiqueta (cadeia de identidade). Nunca nome, CPF ou prontuário (LGPD/HIPAA)."
    },
    "therapyOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "therapyType",
        "patientId"
      ],
      "description": "Ordem de manufatura à qual a amostra precisa pertencer.",
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^ORD-[A-Z0-9]{8}$"
        },
        "therapyType": {
          "enum": [
            "CAR_T_AUTOLOGOUS",
            "MRNA_NEOANTIGEN_VACCINE"
          ]
        },
        "patientId": {
          "type": "string",
          "pattern": "^PT-[A-Z]{2}-[0-9]{6}$",
          "description": "Pseudônimo na ordem; tem de coincidir com patientId (COI)."
        }
      }
    },
    "biopsyType": {
      "enum": [
        "LEUKAPHERESIS_FRESH",
        "LEUKAPHERESIS_CRYO",
        "TUMOR_FRESH_FROZEN",
        "TUMOR_FFPE"
      ],
      "description": "Material coletado: biópsia tumoral (pipeline de neoantígenos para mRNA) ou material de partida por aférese (CAR-T)."
    },
    "sensorTemp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensorId",
        "currentC",
        "minObservedC",
        "maxObservedC",
        "excursionMinutes",
        "recordedAt"
      ],
      "description": "Última leitura do data logger da embalagem.",
      "properties": {
        "sensorId": {
          "type": "string",
          "pattern": "^LOG-[A-Z0-9-]{4,24}$"
        },
        "currentC": {
          "type": "number",
          "minimum": -200,
          "maximum": 60
        },
        "minObservedC": {
          "type": "number",
          "minimum": -200,
          "maximum": 60
        },
        "maxObservedC": {
          "type": "number",
          "minimum": -200,
          "maximum": 60
        },
        "excursionMinutes": {
          "type": "number",
          "minimum": 0,
          "description": "Minutos acumulados fora da faixa, calculados pelo logger."
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "qualityControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cellViabilityPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Viabilidade celular (material de aférese)."
        },
        "tumorContentPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Conteúdo tumoral estimado pela patologia (biópsias)."
        }
      }
    },
    "chainOfCustody": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/custodyEvent"
      },
      "description": "Eventos de custódia em ordem cronológica, começando pela coleta."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "biopsyType"
        ],
        "properties": {
          "biopsyType": {
            "enum": [
              "LEUKAPHERESIS_FRESH",
              "LEUKAPHERESIS_CRYO"
            ]
          }
        }
      },
      "then": {
        "required": [
          "qualityControl"
        ],
        "properties": {
          "qualityControl": {
            "required": [
              "cellViabilityPct"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "biopsyType"
        ],
        "properties": {
          "biopsyType": {
            "enum": [
              "TUMOR_FRESH_FROZEN",
              "TUMOR_FFPE"
            ]
          }
        }
      },
      "then": {
        "required": [
          "qualityControl"
        ],
        "properties": {
          "qualityControl": {
            "required": [
              "tumorContentPct"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "custodyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "timestamp",
        "actor",
        "location"
      ],
      "properties": {
        "step": {
          "enum": [
            "COLLECTION",
            "PACKAGING",
            "COURIER_PICKUP",
            "IN_TRANSIT",
            "HUB_HANDOFF",
            "RECEIVED_AT_MANUFACTURING",
            "RECEIVED_AT_SEQUENCING_LAB"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "description": "Usuário ou sistema responsável (ALCOA+: atribuível)."
        },
        "location": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        }
      }
    }
  }
}
